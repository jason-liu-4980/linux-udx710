config SPRD_CPROC
	bool "Experimental Spreadtrum AP communication processor loader"
	depends on ARM64 && OF && PROC_FS && SPRD_SIPC && EXPERT
	select MFD_SYSCON
	help
	  Preserve the vendor CPROC procfs boot, stop, image-load and status
	  interface, using the bootloader-supplied DT handoff and real syscons.
	  Built-in only; manual unbind is suppressed while complete CP reset
	  coordination and open-handle lifetime handling remain under review.
