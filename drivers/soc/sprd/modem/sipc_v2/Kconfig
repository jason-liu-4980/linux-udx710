config SPRD_SIPC
	bool "Experimental UDX710 local-peer SIPC v2 transport"
	depends on ARM64 && OF && MAILBOX && EXPERT
	select GENERIC_ALLOCATOR
	help
	  AP-side SMSG, SMEM, SBUF and SBLOCK using the standard mailbox
	  framework. The captured local host PSCP, PM_SYS, NR_PHY, V3_PHY
	  and XC4500 peers are supported. PM_SYS uses its dedicated SRAM
	  mapping; modem peers use bounded DDR subpools. Other peers, PCIe
	  and client mode are rejected. This driver is
	  built-in only; unbind is suppressed while complete reset and
	  open-handle lifetime handling remains under development.

if SPRD_SIPC

config SPRD_SIPC_V2
	bool
	default y

config SPRD_SIPC_MBOX_CLIENT
	bool
	default y

config SPRD_SIPC_SPIPE
	bool "SIPC SBUF character devices"

config SPRD_SIPC_SPOOL
	bool "SIPC SBLOCK character devices"

endif
