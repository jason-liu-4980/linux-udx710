		compatible = "arm,gic-v3";
		#interrupt-cells = <0x3>;
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;
		redistributor-stride = <0x0 0x20000>;
		#redistributor-regions = <0x1>;
		interrupt-controller;
		reg = <0x0 0x12000000 0x0 0x20000 0x0 0x12040000 0x0 0x100000>;
		interrupts = <0x1 0x9 0x4>;
		phandle = <0x1>;
