			syscon-names = "shutdown", "deepsleep", "corereset", "sysreset", "getstatus";
			reg = <0x0 0x2000 0x0 0x1000 0x0 0x88000000 0x0 0x15000000 0x0 0x9187f6cc 0x0 0x400>;
			memory-region = <&p113>;
			#address-cells = <0x1>;
			#size-cells = <0x1>;
