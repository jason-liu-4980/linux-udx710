	scproc-pubcp {
		compatible = "sprd,scproc_pubcp";
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;
		status = "okay";
		p114: scproc@0 {
			sprd,name = "pmic";
			syscons = <&p11 0xff 0x0 &p12 0xff 0x100000 &p11 0x210 0x1 &p11 0xff 0x10 &p11 0xff 0x0>;
			syscon-names = "shutdown", "deepsleep", "corereset", "sysreset", "getstatus";
			reg = <0x0 0xb000 0x0 0xdc00>;
			#address-cells = <0x1>;
			#size-cells = <0x1>;
			ranges = <0x0 0x0 0xb000 0xd000>;
			phandle = <0x114>;
			status = "disabled";
