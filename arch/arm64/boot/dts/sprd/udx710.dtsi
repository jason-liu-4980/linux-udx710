/* UDX710 SoC description derived from the original platform interfaces. */


/ {
	interrupt-parent = <&p1>;
	#address-cells = <0x2>;
	#size-cells = <0x2>;
	cpuinfo_hardware = "Unisoc UDX710";
	sprd,sc-id = <0x2c6 0x1 0x20000>;
	aliases {
		serial0 = "/soc/ap-apb/serial@24100000";
		eth0 = "/sipa-eth0";
		eth1 = "/sipa-eth1";
		eth2 = "/sipa-eth2";
		eth3 = "/sipa-eth3";
		eth4 = "/sipa-eth4";
		eth5 = "/sipa-eth5";
		eth6 = "/sipa-eth6";
		eth7 = "/sipa-eth7";
	};
	soc {
		compatible = "simple-bus";
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;
		pcf: syscon@21000000 {
			compatible = "sprd,sys-ap-ahb", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x21000000 0x0 0x100000>;
			phandle = <0xcf>;
		};
		pd2: syscon@24000000 {
			compatible = "sprd,sys-ap-apb", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x24000000 0x0 0x100000>;
			phandle = <0xd2>;
		};
		pc6: syscon@29000000 {
			compatible = "sprd,sys-ap-ipa-ahb", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x29000000 0x0 0x100000>;
			phandle = <0xc6>;
		};
		pd3: syscon@5650d000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x5650d000 0x0 0x1000>;
			phandle = <0xd3>;
		};
		pa: syscon@565e0000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x565e0000 0x0 0x10000>;
			phandle = <0xa>;
		};
		syscon@61030000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x61030000 0x0 0x10000>;
		};
		p14: syscon@61050000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x61050000 0x0 0x10000>;
			phandle = <0x14>;
		};
		pe8: syscon@63020000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63020000 0x0 0x10000>;
			phandle = <0xe8>;
		};
		pe9: syscon@63030000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63030000 0x0 0x10000>;
			phandle = <0xe9>;
		};
		pea: syscon@63040000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63040000 0x0 0x10000>;
			phandle = <0xea>;
		};
		peb: syscon@63050000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63050000 0x0 0x10000>;
			phandle = <0xeb>;
		};
		pec: syscon@63060000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63060000 0x0 0x10000>;
			phandle = <0xec>;
		};
		ped: syscon@63070000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63070000 0x0 0x10000>;
			phandle = <0xed>;
		};
		syscon@63470000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63470000 0x0 0x10000>;
		};
		syscon@63480000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63480000 0x0 0x10000>;
		};
		pcd: syscon@63490000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63490000 0x0 0x10000>;
			phandle = <0xcd>;
		};
		pd4: syscon@634b0000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x634b0000 0x0 0x10000>;
			phandle = <0xd4>;
		};
		pd0: syscon@634c0000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x634c0000 0x0 0x10000>;
			phandle = <0xd0>;
		};
		syscon@634f0000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x634f0000 0x0 0x10000>;
		};
		syscon@63500000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63500000 0x0 0x10000>;
		};
		syscon@63510000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63510000 0x0 0x10000>;
		};
		syscon@63520000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63520000 0x0 0x10000>;
		};
		pb7: syscon@63530000 {
			compatible = "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63530000 0x0 0x10000>;
			phandle = <0xb7>;
		};
		p12: syscon@64010000 {
			compatible = "sprd,sys-pmu-apb", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x64010000 0x0 0x10000>;
			phandle = <0x12>;
		};
		p11: syscon@64020000 {
			compatible = "sprd,sys-aon-apb", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x64020000 0x0 0x10000>;
			phandle = <0x11>;
		};
		ap-ahb {
			compatible = "simple-bus";
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges;
			p10e: dma-controller@21200000 {
				compatible = "sprd,orca-dma";
				reg = <0x0 0x21200000 0x0 0x4000>;
				interrupts = <0x0 0x32 0x4>;
				#dma-cells = <0x1>;
				clock-names = "enable";
				clocks = <&p2 0x4>;
				phandle = <0x10e>;
				dma-channels = <0x1c>;
			};
			nand-controller@21300000 {
				compatible = "sprd,orca-nandc";
				reg = <0x0 0x21300000 0x0 0x1000>;
				interrupts = <0x0 0x3b 0x4>;
				status = "okay";
				clock-names = "nandc_clk", "nandc_ecc_clk", "nandc_parent_sdr", "nandc_parent_ddr", "nandc_ahb_enable", "nandc_ecc_enable", "nandc_26m_enable", "nandc_1x_enable", "nandc_2x_enable";
				clocks = <&p3 0x2e &p4 0x2 &p5 0xf &p5 0xe &p2 0x1 &p2 0x2 &p2 0x3 &p6 0x69 &p6 0x6a>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				nand@0 {
					reg = <0x0>;
					nand-bus-width = <0x8>;
					nand-ecc-mode = "hw";
					nand-ecc-strength = <0x8>;
					nand-ecc-step-size = <0x200>;
					partitions {
						compatible = "fixed-partitions";
						#address-cells = <0x1>;
						#size-cells = <0x1>;
						partition@0 {
							label = "splloader";
							reg = <0x0 0x40000>;
							read-only;
						};
						partition@40000 {
							label = "uboot";
							reg = <0x40000 0x140000>;
							read-only;
						};
						partition@180000 {
							label = "sml";
							reg = <0x180000 0xc0000>;
							read-only;
						};
						partition@240000 {
							label = "trustos";
							reg = <0x240000 0x20000>;
							read-only;
						};
						partition@260000 {
							label = "ubootbak";
							reg = <0x260000 0x140000>;
							read-only;
						};
						partition@3a0000 {
							label = "smlbak";
							reg = <0x3a0000 0xc0000>;
							read-only;
						};
						partition@460000 {
							label = "trustosbak";
							reg = <0x460000 0x20000>;
							read-only;
						};
						partition@480000 {
							label = "ubipac";
							reg = <0x480000 0xfb80000>;
							read-only;
						};
					};
				};
			};
			sdio@26100000 {
				compatible = "sprd,sdhc-r11p1";
				reg = <0x0 0x26100000 0x0 0x1000>;
				interrupts = <0x0 0x3c 0x4>;
				status = "okay";
				clock-names = "sdio_clk", "sdio_clk_source", "sdio_ahb_enable";
				clocks = <&p3 0x2c &p5 0x0 &p2 0xb>;
				sprd,hs400es-dly = <0xc0 0x7f 0x36 0x36>;
				sprd,hs400-dly = <0xc0 0x7f 0x3d 0x3d>;
				sprd,hs200-dly = <0x7f 0x82 0x85 0x85>;
				sprd,ddr52-dly = <0x30 0x1a 0x18 0x18>;
				vmmc-supply = <&p7>;
				voltage-ranges = <0xbb8 0xbb8>;
				bus-width = <0x8>;
				non-removable;
				cap-mmc-hw-reset;
				mmc-hs400-enhanced-strobe;
				mmc-hs400-1_8v;
				mmc_hs200-1_8v;
				mmc-ddr-1_8v;
				sprd,name = "sdio_emmc";
				sprd,sdio-adma;
				no-sdio;
				no-sd;
			};
		};
		ap-apb {
			compatible = "simple-bus";
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges;
			serial@24100000 {
				compatible = "sprd,sc9836-uart", "sprd,sc9838-uart";
				reg = <0x0 0x24100000 0x0 0x100>;
				interrupts = <0x0 0x3 0x4>;
				status = "ok";
				clock-names = "enable", "uart", "source";
				clocks = <&p8 0x1 &p4 0x6 &p9>;
			};
			i2c@24200000 {
				compatible = "sprd,orca-i2c";
				reg = <0x0 0x24200000 0x0 0x1000>;
				interrupts = <0x0 0xb 0x4>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clock-names = "enable", "i2c", "source";
				clocks = <&p8 0x2 &p4 0x7 &p9>;
			};
			i2c@24300000 {
				compatible = "sprd,orca-i2c";
				reg = <0x0 0x24300000 0x0 0x1000>;
				interrupts = <0x0 0xc 0x4>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clock-names = "enable", "i2c", "source";
				clocks = <&p8 0x3 &p4 0x8 &p9>;
			};
			i2c@24400000 {
				compatible = "sprd,orca-i2c";
				reg = <0x0 0x24400000 0x0 0x1000>;
				interrupts = <0x0 0xd 0x4>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clock-names = "enable", "i2c", "source";
				clocks = <&p8 0x4 &p4 0x9 &p9>;
			};
			i2c@24500000 {
				compatible = "sprd,orca-i2c";
				reg = <0x0 0x24500000 0x0 0x1000>;
				interrupts = <0x0 0xe 0x4>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clock-names = "enable", "i2c", "source";
				clocks = <&p8 0x5 &p4 0xa &p9>;
			};
			i2c@24600000 {
				compatible = "sprd,orca-i2c";
				reg = <0x0 0x24600000 0x0 0x1000>;
				interrupts = <0x0 0xf 0x4>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clock-names = "enable", "i2c", "source";
				clocks = <&p8 0x6 &p4 0xb &p9>;
			};
			spi@24700000 {
				compatible = "sprd,sc9860-spi", "sprd,orca-spi";
				reg = <0x0 0x24700000 0x0 0x1000>;
				interrupts = <0x0 0x7 0x4>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clock-names = "enable", "spi", "source";
				clocks = <&p8 0x7 &p3 0x30 &p5 0x5>;
			};
			spi@24800000 {
				compatible = "sprd,sc9860-spi", "sprd,orca-spi";
				reg = <0x0 0x24800000 0x0 0x1000>;
				interrupts = <0x0 0x8 0x4>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clock-names = "enable", "spi", "source";
				clocks = <&p8 0x9 &p3 0x31 &p5 0x5>;
			};
			spi@24900000 {
				compatible = "sprd,sc9860-spi", "sprd,orca-spi";
				reg = <0x0 0x24900000 0x0 0x1000>;
				interrupts = <0x0 0x9 0x4>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clock-names = "enable", "spi", "source";
				clocks = <&p8 0xb &p3 0x32 &p5 0x5>;
			};
			p110: i2s@25000000 {
				compatible = "sprd,i2s";
				status = "disabled";
				sprd,config_type = "pcm";
				sprd,slave_timeout = <0xf11>;
				sprd,fs = <0x1f40>;
				sprd,bus_type = <0x1>;
				sprd,rtx_mode = <0x3>;
				sprd,byte_per_chan = <0x1>;
				sprd,slave_mode = <0x0>;
				sprd,lsb = <0x0>;
				sprd,lrck = <0x0>;
				sprd,low_for_left = <0x1>;
				sprd,clk_inv = <0x0>;
				sprd,pcm_short_frame = <0x1>;
				sprd,pcm_slot = <0x1>;
				sprd,pcm_cycle = <0x1>;
				sprd,tx_watermark = <0xc>;
				sprd,rx_watermark = <0x14>;
				phandle = <0x110>;
			};
		};
		agcp {
			compatible = "simple-bus";
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges;
			p10d: vbc@56480000 {
				compatible = "sprd,roc1-vbc";
				#sound-dai-cells = <0x1>;
				reg = <0x0 0x56480000 0x0 0x1000>;
				sprd,syscon-agcp-ahb = <&pa>;
				sprd,vbc-phy-offset = <0x55000000>;
				pinctrl-names = "vbc_iis3_0", "vbc_iism0_0", "vbc_iis_to_pad", "vbc_iis_to_aon_usb", "vbc_iism0_1";
				pinctrl-0 = <&pb>;
				pinctrl-1 = <&pc>;
				pinctrl-2 = <&pd>;
				pinctrl-3 = <&pe>;
				pinctrl-4 = <&pf>;
				phandle = <0x10d>;
				status = "disabled";
			};
			mcdt@56490000 {
				compatible = "sprd,roc1-mcdt";
				reg = <0x0 0x56490000 0x0 0x170>;
				interrupts = <0x0 0x76 0x4>;
				sprd,ap-addr-offset = <0x55000000>;
				sprd,syscon-agcp-ahb = <&pa>;
				status = "disabled";
			};
			pe3: dma-controller@56580000 {
				compatible = "sprd,roc1-dma";
				reg = <0x0 0x56580000 0x0 0x4000>;
				interrupts = <0x0 0x75 0x4>;
				#dma-cells = <0x1>;
				#dma-channels = <0x20>;
				clock-names = "enable", "ashb_eb";
				clocks = <&p10 0x6 &p10 0xd>;
				phandle = <0xe3>;
				status = "disabled";
			};
			audio-codec@56750000 {
				compatible = "sprd,audio-codec-dig-agcp";
				reg = <0x0 0x56750000 0x0 0x1000>;
				sprd,syscon-agcp-ahb = <&pa>;
				status = "disabled";
			};
			agdsp-access {
				compatible = "sprd,agdsp-access";
				sprd,syscon-agcp-ahb = <&p11>;
				sprd,syscon-pmu-apb = <&p12>;
				syscons = <&p12 0xcc 0x20 &p12 0xd4 0xf000 &p12 0x58c 0xff &p12 0x58c 0xff00 &p11 0x648 0x20>;
				syscon-names = "audcp_pmu_sleep_ctrl", "audcp_pmu_slp_status", "audcp_pmu_pwr_status4", "audcp_pmu_pwr_status3", "ap_access_ena";
				sprd,dst = <0x5>;
				sprd,channel = <0x82>;
				sprd,mailbox-core = <0x5>;
				sprd,ddr-addr-offset = <0x0>;
				hwlocks = <&p13 0xb>;
				sprd,auto_agcp_access = <0x0>;
				status = "disabled";
			};
		};
		pub {
			compatible = "simple-bus";
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges;
			dmc-mpu@61030000 {
				compatible = "sprd,orca-dmc-mpu";
				reg = <0x0 0x61030000 0x0 0x10000>;
				interrupts = <0x0 0x6f 0x4>;
				syscon-names = "irq_clr", "irq_en";
				syscons = <&p14 0x32f0 0x200 &p14 0x32f0 0x100>;
				sprd,channel-num = <0x7>;
				sprd,mpu-num = <0x10>;
				sprd,channel-names = "AP_DMA", "NR_CP1", "NR_CP2", "V3_MODEM1", "V3_MODEM2", "PS_CP", "AG_CP", "IPA", "TFT", "USB_PAM", "PCIE", "CM4", "SHARED0", "SHARED1", "SHARED2", "SHARED3";
				sprd,ranges = <0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0>;
				sprd,chn-config = <0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1>;
				sprd,id-config = <0x0 0x1 0x0 0x0 0x0 0xffff 0x0 0x0 0xffff 0x0 0x0 0xffff 0x0 0x0 0xffff 0x0 0x0 0xffff 0x0 0x0 0xffff 0x0 0x6 0x0 0x0 0x7 0x0 0x0 0xa 0x0 0x0 0xb 0x0 0x0 0x12 0x0 0x0 0x0 0xffff 0x0 0x0 0xffff 0x0 0x0 0xffff 0x0 0x0 0xffff>;
				sprd,port-map = <0x0 0x1 0x2 0x3 0x4 0x5 0x6 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0>;
				sprd,ddr-offset = <0x80000000>;
				status = "disabled";
				sprd,panic;
			};
			dmc-controller@61050000 {
				compatible = "sprd,orca-dmc";
				reg = <0x0 0x61050000 0x0 0x7000 0x0 0x6000 0x0 0x1000>;
				status = "disabled";
			};
			ptm@61060000 {
				compatible = "sprd,orca-ptm";
				reg = <0x0 0x61060000 0x0 0x10000 0x0 0x78002000 0x0 0x1000 0x0 0x78003000 0x0 0x1000 0x0 0x78006000 0x0 0x1000>;
				interrupts = <0x0 0x6d 0x4>;
				clock-names = "clk_cs", "cs_src";
				clocks = <&p3 0x26 &p5 0xb>;
				sprd,funnel-port = <0x5>;
				sprd,ddr-chn = <0x7>;
				sprd,chn-name = "APCPU/miniAP/CS/AON", "NRCPU", "NRACC", "V3CPU", "V3ACC", "PSCP", "AGCP";
				status = "disabled";
			};
		};
		aon {
			compatible = "simple-bus";
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges;
			pce: gpio@631d0000 {
				compatible = "sprd,orca-eic-debounce", "sprd,sharkl5-eic-debounce";
				reg = <0x0 0x631d0000 0x0 0x80 0x0 0x631e0000 0x0 0x80 0x0 0x631f0000 0x0 0x80 0x0 0x63200000 0x0 0x80>;
				gpio-controller;
				#gpio-cells = <0x2>;
				interrupt-controller;
				#interrupt-cells = <0x2>;
				interrupts = <0x0 0x48 0x4>;
				phandle = <0xce>;
			};
			gpio@631d0080 {
				compatible = "sprd,orca-eic-latch", "sprd,sharkl5-eic-latch";
				reg = <0x0 0x631d0080 0x0 0x20 0x0 0x631e0080 0x0 0x20 0x0 0x631f0080 0x0 0x20 0x0 0x63200080 0x0 0x20>;
				gpio-controller;
				#gpio-cells = <0x2>;
				interrupt-controller;
				#interrupt-cells = <0x2>;
				interrupts = <0x0 0x48 0x4>;
			};
			pcb: gpio@631d00a0 {
