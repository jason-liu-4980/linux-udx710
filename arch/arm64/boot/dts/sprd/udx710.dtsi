	cpus {
		#address-cells = <0x2>;
		#size-cells = <0x0>;
		cpu-map {
			cluster0 {
				core0 {
					cpu = <&pdf>;
				};
				core1 {
					cpu = <&pe1>;
				};
			};
		};
		pdf: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55", "arm,armv8";
			reg = <0x0 0x0>;
			enable-method = "psci";
			cpu-idle-states = <&pe6>;
			cpufreq-data-v1 = <&pe7>;
			phandle = <0xdf>;
			#cooling-cells = <0x2>;
		};
		pe1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55", "arm,armv8";
			reg = <0x0 0x100>;
			enable-method = "psci";
			cpu-idle-states = <&pe6>;
			cpufreq-data-v1 = <&pe7>;
			phandle = <0xe1>;
			#cooling-cells = <0x2>;
		};
	};
	idle-states {
		entry-method = "arm,psci";
		pe6: core_pd {
			compatible = "arm,idle-state";
			entry-latency-us = <0xfa0>;
			exit-latency-us = <0xfa0>;
			min-residency-us = <0x2710>;
			local-timer-stop;
			arm,psci-suspend-param = <0x10000>;
			phandle = <0xe6>;
		};
	};
	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};
	pe7: cpufreq-clus0 {
		voltage-step = <0xb71b0>;
		boost-duration = <0x0>;
		tuning-latency-us = <0xc8>;
		phandle = <0xe7>;
	};
	cpufreq-scu {
		cpufreq-cluster-id = <0x1>;
		clock-latency = <0xc350>;
		voltage-latency = <0x0>;
		operating-points = <0xf78f0 0xc3500 0xbb800 0xc3500 0x7d000 0xc3500 0x72420 0xc3500 0x5dc00 0xc3500 0x2ee00 0xc3500>;
	};
	cpufreq-periph {
		cpufreq-cluster-id = <0x2>;
		clock-latency = <0xc350>;
		voltage-latency = <0x0>;
		operating-points = <0x5dc00 0xc3500 0x3e800 0xc3500 0x2ee00 0xc3500 0x25800 0xc3500 0x1f400 0xc3500>;
	};
