	};
	p10f: sprd-pcm-iis {
		compatible = "sprd,sharkl5-pcm-platform";
		#sound-dai-cells = <0x0>;
		dmas = <&p10e 0x5 &p10e 0x6>;
		dma-names = "iis0_tx", "iis0_rx";
		sprd,dma-2stage-usecase = <0x2>;
		sprd,node-count-2stage-level-1 = <0x1>;
		sprd,syscon-pmu-apb = <&p12>;
		sprd,dma-2stage-level-1-int-source = <0x1>;
		phandle = <0x10f>;
		status = "disabled";
	};
	sound@1 {
		compatible = "sprd,i2s-null-codec";
		status = "disabled";
		sprd-audio-card,name = "all-i2s";
		sprd-audio-card,dai-link@0 {
			plat {
				sound-dai = <&p10f>;
			};
			cpu {
				sound-dai = <&p110>;
			};
			codec {
				sound-dai = <0x0 0x0>;
			};
		};
	};
	p111: memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
		phandle = <0x111>;
	};
	chosen {
		stdout-path = "/soc/ap-apb/serial@24100000:115200n8";
		bootargs = "console=ttyS0,115200n8 earlycon loglevel=7 init=/sbin/init ubi.mtd=ubipac root=ubi0:system rootfstype=ubifs rootwait ro";
	};
	ion {
		compatible = "sprd,ion";
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		status = "disabled";
		heap@0 {
			reg = <0x0>;
			label = "system";
			type = <0x0>;
		};
	};
	pc8: extcon_usb0 {
		compatible = "linux,extcon-usb-gpio";
		vbus-gpios = <&pbd 0x0 0x0>;
		phandle = <0xc8>;
	};
	sprd-sysdump {
		memory-region = <&p111>;
		memory-region-re = <0x112 0x113 0x114 0x115 0x116>;
	};
	sprd-verify {
		compatible = "sprd,orca-verify";
		nvmem-names = "ap-efuse";
		nvmem = <0x117>;
		status = "disabled";
	};
	gpio-ctrl {
		compatible = "sprd,gpio-ctrl";
		rst_mcu = <0x118 0x46 0x0>;
		wkup_mcu = <0x118 0x47 0x0>;
		status = "disabled";
	};
	board_temp {
		compatible = "sprd,board_temp_adc";
		io-channels = <&pbf 0x2 &pbf 0x4 &pbf 0x6>;
		io-channel-names = "temp_cp", "temp_234g", "temp_nr";
		status = "disabled";
	};
	gpio-keys {
		compatible = "gpio-keys";
		key-factoryrst {
			label = "Factory Rst Key";
			linux,code = <0x57>;
			gpios = <&pce 0x2 0x1>;
			debounce-interval = <0x2>;
			wakeup-source;
		};
		key-poweroff {
			label = "Power Off Key";
			linux,code = <0x58>;
			gpios = <&pce 0x1 0x1>;
			debounce-interval = <0x2>;
			wakeup-source;
		};
		key-volumedown {
			label = "Volume Down Key";
			linux,code = <0x72>;
			gpios = <&pce 0x0 0x1>;
			debounce-interval = <0x2>;
			wakeup-source;
		};
		key-volumeup {
			label = "Volume Up Key";
			linux,code = <0x73>;
			gpios = <&pbd 0x4 0x0>;
			debounce-interval = <0x2>;
			wakeup-source;
		};
		key-power {
			label = "Power Key";
			linux,code = <0x74>;
			gpios = <&pbd 0x1 0x1>;
			debounce-interval = <0x2>;
			wakeup-source;
		};
		key-equal {
			label = "KPequal Key";
			linux,code = <0x75>;
			gpios = <&pbd 0x2 0x1>;
			debounce-interval = <0x2>;
			wakeup-source;
		};
	};
	dvfs-dcdc-cpu0-supply {
		supply-type-sel = <0x29c 0x0 0x0>;
		top-dvfs-adi-state = <0x88 0x0 0xf>;
		voltage-grade-num = <0x7>;
		voltage-grade = <0x0 0x100 0x240 0x0 0x1fff 0x1 0x100 0x240 0x9 0x1fff 0x2 0x100 0x240 0x12 0x1fff 0x3 0x100 0x244 0x0 0x1fff 0x4 0x100 0x244 0x9 0x1fff 0x5 0x100 0x244 0x12 0x1fff 0x6 0x100 0x248 0x0 0x1fff>;
		tuning-latency-us = <0xc8>;
		chnl-in-i2c = <0x0>;
	};
	p180: usb-reset-controller {
		compatible = "sprd,orca-usb-reset";
		#reset-cells = <0x1>;
		sprd,ap-ahb = <&pcf>;
		sprd,ipa-ahb = <&pc6>;
		phandle = <0x180>;
	};
};

#include "udx710-adi.dtsi"
#include "udx710-thermal.dtsi"
#include "udx710-pmsys.dtsi"
