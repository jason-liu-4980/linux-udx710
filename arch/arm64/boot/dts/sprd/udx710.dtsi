// SPDX-License-Identifier: GPL-2.0-only
/* UDX710 controllers and silicon resources. The board supplies ext_26m and
 * ext_32k clock inputs and selects CPU frequency policy. */

/ {
	interrupt-parent = <&gic>;
	#address-cells = <0x2>;
	#size-cells = <0x2>;
	soc {
		compatible = "simple-bus";
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;
		ap_ahb: syscon@21000000 {
			compatible = "sprd,sys-ap-ahb", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x21000000 0x0 0x100000>;
		};
		ap_apb: syscon@24000000 {
			compatible = "sprd,sys-ap-apb", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x24000000 0x0 0x100000>;
		};
		ipa_ahb: syscon@29000000 {
			compatible = "sprd,sys-ap-ipa-ahb", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x29000000 0x0 0x100000>;
		};
		audcp_apb: syscon@5650d000 {
			compatible = "sprd,udx710-audcp-apb-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x5650d000 0x0 0x1000>;
		};
		audcp_ahb: syscon@565e0000 {
			compatible = "sprd,udx710-audcp-ahb-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x565e0000 0x0 0x10000>;
		};
		syscon@61030000 {
			compatible = "sprd,udx710-dmc-mpu-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x61030000 0x0 0x10000>;
		};
		pub_apb: syscon@61050000 {
			compatible = "sprd,udx710-pub-apb-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x61050000 0x0 0x10000>;
		};
		ap_intc0: syscon@63020000 {
			compatible = "sprd,udx710-ap-intc-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63020000 0x0 0x10000>;
		};
		ap_intc1: syscon@63030000 {
			compatible = "sprd,udx710-ap-intc-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63030000 0x0 0x10000>;
		};
		ap_intc2: syscon@63040000 {
			compatible = "sprd,udx710-ap-intc-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63040000 0x0 0x10000>;
		};
		ap_intc3: syscon@63050000 {
			compatible = "sprd,udx710-ap-intc-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63050000 0x0 0x10000>;
		};
		ap_intc4: syscon@63060000 {
			compatible = "sprd,udx710-ap-intc-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63060000 0x0 0x10000>;
		};
		ap_intc5: syscon@63070000 {
			compatible = "sprd,udx710-ap-intc-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63070000 0x0 0x10000>;
		};
		syscon@63470000 {
			compatible = "sprd,udx710-anlg-g0-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63470000 0x0 0x10000>;
		};
		syscon@63480000 {
			compatible = "sprd,udx710-anlg-g1-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63480000 0x0 0x10000>;
		};
		anlg_g2: syscon@63490000 {
			compatible = "sprd,udx710-anlg-g2-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63490000 0x0 0x10000>;
		};
		anlg_g3: syscon@634b0000 {
			compatible = "sprd,udx710-anlg-g3-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x634b0000 0x0 0x10000>;
		};
		anlg_g4: syscon@634c0000 {
			compatible = "sprd,udx710-anlg-g4-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x634c0000 0x0 0x10000>;
		};
		syscon@634f0000 {
			compatible = "sprd,udx710-anlg-g5-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x634f0000 0x0 0x10000>;
		};
		syscon@63500000 {
			compatible = "sprd,udx710-anlg-g8-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63500000 0x0 0x10000>;
		};
		syscon@63510000 {
			compatible = "sprd,udx710-anlg-g9-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63510000 0x0 0x10000>;
		};
		syscon@63520000 {
			compatible = "sprd,udx710-anlg-g10-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63520000 0x0 0x10000>;
		};
		anlg_g11: syscon@63530000 {
			compatible = "sprd,udx710-anlg-g11-syscon", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x63530000 0x0 0x10000>;
		};
		pmu_apb: syscon@64010000 {
			compatible = "sprd,sys-pmu-apb", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x64010000 0x0 0x10000>;
		};
		aon_apb: syscon@64020000 {
			compatible = "sprd,sys-aon-apb", "syscon";
			#syscon-cells = <0x2>;
			reg = <0x0 0x64020000 0x0 0x10000>;
		};
		ap-ahb-bus {
			compatible = "simple-bus";
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges;
			ap_dma: dma-controller@21200000 {
				compatible = "sprd,orca-dma";
				reg = <0x0 0x21200000 0x0 0x4000>;
				interrupts = <0x0 0x32 0x4>;
				#dma-cells = <0x1>;
				clock-names = "enable";
				clocks = <&ap_ahb_gate 0x4>;
				dma-channels = <0x1c>;
			};
			nand-controller@21300000 {
			status = "disabled";
				compatible = "sprd,orca-nandc";
				reg = <0x0 0x21300000 0x0 0x1000>;
				interrupts = <0x0 0x3b 0x4>;
				clock-names = "nandc_clk", "nandc_ecc_clk", "nandc_parent_sdr", "nandc_parent_ddr", "nandc_ahb_enable", "nandc_ecc_enable", "nandc_26m_enable", "nandc_1x_enable", "nandc_2x_enable";
				clocks = <&aon_clk 0x2e &ap_clk 0x2 &g3_pll 0xf &g3_pll 0xe &ap_ahb_gate 0x1 &ap_ahb_gate 0x2 &ap_ahb_gate 0x3 &aon_apb_gate 0x69 &aon_apb_gate 0x6a>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
			};
			sdio@26100000 {
				status = "disabled";
				compatible = "sprd,sdhc-r11p1";
				reg = <0x0 0x26100000 0x0 0x1000>;
				interrupts = <0x0 0x3c 0x4>;
				clock-names = "sdio_clk", "sdio_clk_source", "sdio_ahb_enable";
				clocks = <&aon_clk 0x2c &g3_pll 0x0 &ap_ahb_gate 0xb>;
			};
		};
		ap-apb-bus {
			compatible = "simple-bus";
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges;
			serial@24100000 {
			status = "disabled";
				compatible = "sprd,sc9836-uart";
				reg = <0x0 0x24100000 0x0 0x100>;
				interrupts = <0x0 0x3 0x4>;
				clock-names = "enable", "uart", "source";
				clocks = <&ap_apb_gate 0x1 &ap_clk 0x6 &ext_26m>;
			};
			i2c@24200000 {
				compatible = "sprd,orca-i2c";
				reg = <0x0 0x24200000 0x0 0x1000>;
				interrupts = <0x0 0xb 0x4>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clock-names = "enable", "i2c", "source";
				clocks = <&ap_apb_gate 0x2 &ap_clk 0x7 &ext_26m>;
			};
			i2c@24300000 {
				compatible = "sprd,orca-i2c";
				reg = <0x0 0x24300000 0x0 0x1000>;
				interrupts = <0x0 0xc 0x4>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clock-names = "enable", "i2c", "source";
				clocks = <&ap_apb_gate 0x3 &ap_clk 0x8 &ext_26m>;
			};
			i2c@24400000 {
				compatible = "sprd,orca-i2c";
				reg = <0x0 0x24400000 0x0 0x1000>;
				interrupts = <0x0 0xd 0x4>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clock-names = "enable", "i2c", "source";
				clocks = <&ap_apb_gate 0x4 &ap_clk 0x9 &ext_26m>;
			};
			i2c@24500000 {
				compatible = "sprd,orca-i2c";
				reg = <0x0 0x24500000 0x0 0x1000>;
				interrupts = <0x0 0xe 0x4>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clock-names = "enable", "i2c", "source";
				clocks = <&ap_apb_gate 0x5 &ap_clk 0xa &ext_26m>;
			};
			i2c@24600000 {
				compatible = "sprd,orca-i2c";
				reg = <0x0 0x24600000 0x0 0x1000>;
				interrupts = <0x0 0xf 0x4>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clock-names = "enable", "i2c", "source";
				clocks = <&ap_apb_gate 0x6 &ap_clk 0xb &ext_26m>;
			};
			spi@24700000 {
				compatible = "sprd,sc9860-spi", "sprd,orca-spi";
				reg = <0x0 0x24700000 0x0 0x1000>;
				interrupts = <0x0 0x7 0x4>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clock-names = "enable", "spi", "source";
				clocks = <&ap_apb_gate 0x7 &aon_clk 0x30 &g3_pll 0x5>;
			};
			spi@24800000 {
				compatible = "sprd,sc9860-spi", "sprd,orca-spi";
				reg = <0x0 0x24800000 0x0 0x1000>;
				interrupts = <0x0 0x8 0x4>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clock-names = "enable", "spi", "source";
				clocks = <&ap_apb_gate 0x9 &aon_clk 0x31 &g3_pll 0x5>;
			};
			spi@24900000 {
				compatible = "sprd,sc9860-spi", "sprd,orca-spi";
				reg = <0x0 0x24900000 0x0 0x1000>;
				interrupts = <0x0 0x9 0x4>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
				clock-names = "enable", "spi", "source";
				clocks = <&ap_apb_gate 0xb &aon_clk 0x32 &g3_pll 0x5>;
			};
			i2s0: i2s@25000000 {
				compatible = "sprd,i2s";
				status = "disabled";
			};
		};
		agcp-bus {
			compatible = "simple-bus";
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges;
			vbc: vbc@56480000 {
				compatible = "sprd,roc1-vbc";
				#sound-dai-cells = <0x1>;
				reg = <0x0 0x56480000 0x0 0x1000>;
				sprd,syscon-agcp-ahb = <&audcp_ahb>;
				sprd,vbc-phy-offset = <0x55000000>;
				status = "disabled";
			};
			mcdt@56490000 {
				compatible = "sprd,roc1-mcdt";
				reg = <0x0 0x56490000 0x0 0x170>;
				interrupts = <0x0 0x76 0x4>;
				sprd,ap-addr-offset = <0x55000000>;
				status = "disabled";
			};
			audcp_dma: dma-controller@56580000 {
				compatible = "sprd,roc1-dma";
				reg = <0x0 0x56580000 0x0 0x4000>;
				interrupts = <0x0 0x75 0x4>;
				#dma-cells = <0x1>;
				#dma-channels = <0x20>;
				clock-names = "enable", "ashb_eb";
				clocks = <&audcp_ahb_gate 0x6 &audcp_ahb_gate 0xd>;
				status = "disabled";
			};
			audio-codec@56750000 {
				compatible = "sprd,audio-codec-dig-agcp";
				reg = <0x0 0x56750000 0x0 0x1000>;
				sprd,syscon-agcp-ahb = <&audcp_ahb>;
				status = "disabled";
			};
			agdsp-access {
				compatible = "sprd,agdsp-access";
				sprd,syscon-agcp-ahb = <&aon_apb>;
				sprd,syscon-pmu-apb = <&pmu_apb>;
				syscons = <&pmu_apb 0xcc 0x20 &pmu_apb 0xd4 0xf000 &pmu_apb 0x58c 0xff &pmu_apb 0x58c 0xff00 &aon_apb 0x648 0x20>;
				syscon-names = "audcp_pmu_sleep_ctrl", "audcp_pmu_slp_status", "audcp_pmu_pwr_status4", "audcp_pmu_pwr_status3", "ap_access_ena";
				sprd,dst = <0x5>;
				sprd,channel = <0x82>;
				sprd,mailbox-core = <0x5>;
				sprd,ddr-addr-offset = <0x0>;
				hwlocks = <&hwspinlock 0xb>;
				sprd,auto_agcp_access = <0x0>;
				status = "disabled";
			};
		};
		pub-bus {
			compatible = "simple-bus";
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges;
			dmc-mpu@61030000 {
				compatible = "sprd,orca-dmc-mpu";
				reg = <0x0 0x61030000 0x0 0x10000>;
				interrupts = <0x0 0x6f 0x4>;
				syscon-names = "irq_clr", "irq_en";
				syscons = <&pub_apb 0x32f0 0x200 &pub_apb 0x32f0 0x100>;
				sprd,channel-num = <0x7>;
				sprd,mpu-num = <0x10>;
				sprd,channel-names = "AP_DMA", "NR_CP1", "NR_CP2", "V3_MODEM1", "V3_MODEM2", "PS_CP", "AG_CP", "IPA", "TFT", "USB_PAM", "PCIE", "CM4", "SHARED0", "SHARED1", "SHARED2", "SHARED3";
				sprd,ranges = <0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0>;
				sprd,chn-config = <0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1 0x0 0x1 0x1>;
				sprd,id-config = <0x0 0x1 0x0 0x0 0x0 0xffff 0x0 0x0 0xffff 0x0 0x0 0xffff 0x0 0x0 0xffff 0x0 0x0 0xffff 0x0 0x0 0xffff 0x0 0x6 0x0 0x0 0x7 0x0 0x0 0xa 0x0 0x0 0xb 0x0 0x0 0x12 0x0 0x0 0x0 0xffff 0x0 0x0 0xffff 0x0 0x0 0xffff 0x0 0x0 0xffff>;
				sprd,port-map = <0x0 0x1 0x2 0x3 0x4 0x5 0x6 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0>;
				sprd,ddr-offset = <0x80000000>;
				status = "disabled";
				sprd,panic;
			};
			dmc-controller@61050000 {
				compatible = "sprd,orca-dmc";
				reg = <0x0 0x61050000 0x0 0x7000 0x0 0x6000 0x0 0x1000>;
				status = "disabled";
			};
			ptm@61060000 {
				compatible = "sprd,orca-ptm";
				reg = <0x0 0x61060000 0x0 0x10000 0x0 0x78002000 0x0 0x1000 0x0 0x78003000 0x0 0x1000 0x0 0x78006000 0x0 0x1000>;
				interrupts = <0x0 0x6d 0x4>;
				clock-names = "clk_cs", "cs_src";
				clocks = <&aon_clk 0x26 &g3_pll 0xb>;
				sprd,funnel-port = <0x5>;
				sprd,ddr-chn = <0x7>;
				sprd,chn-name = "APCPU/miniAP/CS/AON", "NRCPU", "NRACC", "V3CPU", "V3ACC", "PSCP", "AGCP";
				status = "disabled";
			};
		};
		aon-bus {
			compatible = "simple-bus";
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges;
			eic_debounce: gpio@631d0000 {
				compatible = "sprd,orca-eic-debounce", "sprd,sharkl5-eic-debounce";
				reg = <0x0 0x631d0000 0x0 0x80 0x0 0x631e0000 0x0 0x80 0x0 0x631f0000 0x0 0x80 0x0 0x63200000 0x0 0x80>;
				gpio-controller;
				#gpio-cells = <0x2>;
				interrupt-controller;
				#interrupt-cells = <0x2>;
				interrupts = <0x0 0x48 0x4>;
			};
			gpio@631d0080 {
				compatible = "sprd,orca-eic-latch", "sprd,sharkl5-eic-latch";
				reg = <0x0 0x631d0080 0x0 0x20 0x0 0x631e0080 0x0 0x20 0x0 0x631f0080 0x0 0x20 0x0 0x63200080 0x0 0x20>;
				gpio-controller;
				#gpio-cells = <0x2>;
				interrupt-controller;
				#interrupt-cells = <0x2>;
				interrupts = <0x0 0x48 0x4>;
			};
			eic_async: gpio@631d00a0 {
				compatible = "sprd,orca-eic-async", "sprd,sharkl5-eic-async";
				reg = <0x0 0x631d00a0 0x0 0x20 0x0 0x631e00a0 0x0 0x20 0x0 0x631f00a0 0x0 0x20 0x0 0x632000a0 0x0 0x20>;
				gpio-controller;
				#gpio-cells = <0x2>;
				interrupt-controller;
				#interrupt-cells = <0x2>;
				interrupts = <0x0 0x48 0x4>;
			};
			gpio@631d00c0 {
				compatible = "sprd,orca-eic-sync", "sprd,sharkl5-eic-sync";
				reg = <0x0 0x631d00c0 0x0 0x20 0x0 0x631e00c0 0x0 0x20 0x0 0x631f00c0 0x0 0x20 0x0 0x632000c0 0x0 0x20>;
				gpio-controller;
				#gpio-cells = <0x2>;
				interrupt-controller;
				#interrupt-cells = <0x2>;
				interrupts = <0x0 0x48 0x4>;
			};
			timer@63260000 {
				compatible = "sprd,orca-timer";
				reg = <0x0 0x63260000 0x0 0x20>;
				interrupts = <0x0 0x47 0x4>;
				clocks = <&ext_32k>;
				status = "disabled";
			};
			timer@63260020 {
				compatible = "sprd,orca-suspend-timer";
				reg = <0x0 0x63260020 0x0 0x20>;
				clocks = <&ext_32k>;
				status = "disabled";
			};
			serial@620e0000 {
				compatible = "sprd,sc9836-uart-ex";
				reg = <0x0 0x620e0000 0x0 0x100>;
				interrupts = <0x0 0x1 0x4>;
				status = "disabled";
				clock-names = "enable", "uart", "source";
				clocks = <&sp_ahb_gate 0x0 &aon_clk 0xc &ext_26m>;
			};
			i2c@632c0000 {
				compatible = "sprd,orca-hw-i2c";
				reg = <0x0 0x632c0000 0x0 0x1000>;
				interrupts = <0x0 0x44 0x4>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				status = "disabled";
			};
			gpio: gpio@632d0000 {
				compatible = "sprd,orca-gpio", "sprd,sc9860-gpio";
				reg = <0x0 0x632d0000 0x0 0x10000>;
				gpio-controller;
				#gpio-cells = <0x2>;
				interrupt-controller;
				#interrupt-cells = <0x2>;
				interrupts = <0x0 0x3d 0x4>;
			};
			mailbox: mailbox@63300000 {
				compatible = "sprd,orca-mailbox";
				reg = <0x0 0x63300000 0x0 0x1000 0x0 0x63310000 0x0 0x10000>;
				interrupts = <0x0 0x52 0x4 0x0 0x53 0x4>;
				status = "okay";
				#mbox-cells = <0x1>;
				interrupt-names = "inbox", "outbox";
				clocks = <&aon_apb_gate 0x20>;
				clock-names = "enable";
			};
			ap_efuse: efuse@63400000 {
				compatible = "sprd,orca-efuse";
				reg = <0x0 0x63400000 0x0 0x10000>;
				clock-names = "enable";
				hwlocks = <&hwspinlock 0x8>;
