				reg-names = "dbi", "dbi2", "addr_space";
				interrupts = <0x0 0x37 0x4>;
				num-lanes = <0x1>;
				num-ib-windows = <0x6>;
				num-ob-windows = <0x8>;
				pcie-perst-gpios = <&eic_debounce 0x1e 0x0>;
				status = "disabled";
			};
			pamu3: pamu3@2b300000 {
			status = "disabled";
				compatible = "sprd,orca-pamu3";
				clocks = <&ipa_gate 0x8>;
				clock-names = "pamu3_clk";
				reg = <0x0 0x2b300000 0x0 0x10000>;
				reg-names = "pamu3_glb_regs";
				sprd,dwc3 = <&usb1_dwc3>;
				sprd,sipa = <&sipa>;
				resets = <&usb_reset 0x1>;
				reset-names = "pamu3";
			};
			usb0_phy: ssphy0@634d0000 {
				compatible = "sprd,orca1-ssphy0";
				reg = <0x0 0x634d0000 0x0 0x10000>;
				reg-names = "ssphy_glb_regs";
				sprd,syscon-aon-apb = <&aon_apb>;
				sprd,syscon-ap-ahb = <&ap_ahb>;
				sprd,syscon-ipa-ahb = <&ipa_ahb>;
				sprd,syscon-anag4 = <&anlg_g4>;
				status = "disabled";
				#phy-cells = <0>;
				resets = <&usb_reset 0>;
			};
			usb1_phy: ssphy@634e0000 {
			status = "disabled";
				compatible = "sprd,orca1-ssphy1";
				reg = <0x0 0x634e0000 0x0 0x10000>;
				reg-names = "ssphy_glb_regs";
				sprd,syscon-aon-apb = <&aon_apb>;
				sprd,syscon-ap-ahb = <&ap_ahb>;
				sprd,syscon-ipa-ahb = <&ipa_ahb>;
				sprd,syscon-anag4 = <&anlg_g4>;
				#phy-cells = <0x0>;
				resets = <&usb_reset 0x1>;
			};
		};
		ap_clk: clock-controller@21100000 {
			compatible = "sprd,orca-ap-clk";
			reg = <0x0 0x21100000 0x0 0x1000>;
			clocks = <&ext_26m>;
			#clock-cells = <0x1>;
		};
		audcpapb-gate {
			compatible = "sprd,orca-audcpapb-gate";
			sprd,syscon = <&audcp_apb>;
			clocks = <&ext_26m>;
			#clock-cells = <0x1>;
			status = "disabled";
		};
		audcp_ahb_gate: audcpahb-gate {
			compatible = "sprd,orca-audcpahb-gate";
			sprd,syscon = <&audcp_ahb>;
			clocks = <&ext_26m>;
			#clock-cells = <0x1>;
			status = "disabled";
		};
		aon_clk: clock-controller@63170000 {
			compatible = "sprd,orca-aon-clk";
			reg = <0x0 0x63170000 0x0 0x1000>;
			clocks = <&ext_26m>;
			#clock-cells = <0x1>;
		};
		clock-controller@63970000 {
			compatible = "sprd,orca-apcpu-clk";
			reg = <0x0 0x63970000 0x0 0x1000>;
			clocks = <&ext_26m>;
			#clock-cells = <0x1>;
		};
		sp_ahb_gate: clock-controller@62010000 {
			compatible = "sprd,orca-spahb-gate";
			reg = <0x0 0x62010000 0x0 0x3000>;
			clocks = <&ext_26m>;
			#clock-cells = <0x1>;
			status = "disabled";
		};
		funnel@78002000 {
			compatible = "arm,coresight-funnel", "arm,primecell";
			reg = <0x0 0x78002000 0x0 0x1000>;
			clocks = <&ext_26m>;
			clock-names = "apb_pclk";
			status = "disabled";
			ports {
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				port@0 {
					reg = <0x0>;
					funnel_78002000_port_0_endpoint: endpoint {
						remote-endpoint = <&etb_78003000_port_endpoint>;
					};
				};
				port@1 {
					reg = <0x0>;
					funnel_78002000_port_1_endpoint: endpoint {
						slave-mode;
						remote-endpoint = <&funnel_7a004000_port_0_endpoint>;
					};
				};
			};
		};
		etb@78003000 {
			compatible = "arm,coresight-tmc", "arm,primecell";
			reg = <0x0 0x78003000 0x0 0x1000>;
			clocks = <&ext_26m>;
			clock-names = "apb_pclk";
			status = "disabled";
			port {
				etb_78003000_port_endpoint: endpoint {
					slave-mode;
					remote-endpoint = <&funnel_78002000_port_0_endpoint>;
				};
			};
		};
		ts@78009000 {
			compatible = "arm,coresight-ts", "arm,primecell";
			reg = <0x0 0x78009000 0x0 0x1000>;
			status = "disabled";
		};
		funnel@7a001000 {
			compatible = "arm,coresight-funnel", "arm,primecell";
			reg = <0x0 0x7a001000 0x0 0x1000>;
			clocks = <&ext_26m>;
			clock-names = "apb_pclk";
			status = "disabled";
			ports {
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				port@0 {
					reg = <0x0>;
					funnel_7a001000_port_0_endpoint: endpoint {
						remote-endpoint = <&etf_7a002000_port_1_endpoint>;
					};
				};
				port@1 {
					reg = <0x0>;
					funnel_7a001000_port_1_endpoint: endpoint {
						slave-mode;
						remote-endpoint = <&etm_7b040000_port_endpoint>;
					};
				};
				port@2 {
					reg = <0x1>;
					funnel_7a001000_port_2_endpoint: endpoint {
						slave-mode;
						remote-endpoint = <&etm_7b140000_port_endpoint>;
					};
				};
			};
		};
		etf@7a002000 {
			compatible = "arm,coresight-tmc", "arm,primecell";
			reg = <0x0 0x7a002000 0x0 0x1000>;
			clocks = <&ext_26m>;
			clock-names = "apb_pclk";
			status = "disabled";
			port@0 {
				etf_7a002000_port_0_endpoint: endpoint {
					remote-endpoint = <&funnel_7a004000_port_1_endpoint>;
				};
			};
			port@1 {
				etf_7a002000_port_1_endpoint: endpoint {
					slave-mode;
					remote-endpoint = <&funnel_7a001000_port_0_endpoint>;
				};
			};
		};
		funnel@7a004000 {
			compatible = "arm,coresight-funnel", "arm,primecell";
			reg = <0x0 0x7a004000 0x0 0x1000>;
			clocks = <&ext_26m>;
			clock-names = "apb_pclk";
			status = "disabled";
			ports {
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				port@0 {
					reg = <0x0>;
					funnel_7a004000_port_0_endpoint: endpoint {
						remote-endpoint = <&funnel_78002000_port_1_endpoint>;
					};
				};
				port@1 {
					reg = <0x0>;
					funnel_7a004000_port_1_endpoint: endpoint {
						slave-mode;
						remote-endpoint = <&etf_7a002000_port_0_endpoint>;
					};
				};
			};
		};
		etm@7b040000 {
			compatible = "arm,coresight-etm4x", "arm,primecell";
			reg = <0x0 0x7b040000 0x0 0x1000>;
			cpu = <&cpu0>;
			clocks = <&ext_26m &aon_clk 0x26 &g3_pll 0x4>;
			clock-names = "apb_pclk", "clk_cs", "cs_src";
			status = "disabled";
			port {
				etm_7b040000_port_endpoint: endpoint {
					remote-endpoint = <&funnel_7a001000_port_1_endpoint>;
				};
			};
		};
		etm@7b140000 {
			compatible = "arm,coresight-etm4x", "arm,primecell";
			reg = <0x0 0x7b140000 0x0 0x1000>;
			cpu = <&cpu1>;
			clocks = <&ext_26m &aon_clk 0x26 &g3_pll 0x4>;
			clock-names = "apb_pclk", "clk_cs", "cs_src";
			status = "disabled";
			port {
				etm_7b140000_port_endpoint: endpoint {
					remote-endpoint = <&funnel_7a001000_port_2_endpoint>;
				};
			};
		};
	};
	audiocp_boot {
		compatible = "sprd,orca-audcp-boot";
		syscons = <&pmu_apb 0x60 0x2000000 &pmu_apb 0x5c 0x1000000 &pmu_apb 0xcc 0x10 &pmu_apb 0xb0 0x400 &pmu_apb 0xb0 0x200 &pmu_apb 0x6b0 0x3ff &pmu_apb 0x58c 0xff &pmu_apb 0x58c 0xff00 &pmu_apb 0xd4 0xf000 &aon_apb 0x60c 0xffff &aon_apb 0x640 0xffffffff &aon_apb 0x644 0x1>;
		syscon-names = "sysshutdown", "coreshutdown", "deepsleep", "corereset", "sysreset", "reset_sel", "sysstatus", "corestatus", "sleepstatus", "bootprotect", "bootvector", "bootaddress_sel";
		status = "disabled";
	};
	rco-100m {
		compatible = "fixed-clock";
		#clock-cells = <0x0>;
		clock-frequency = <0x5f5e100>;
		clock-output-names = "rco-100m";
	};
	cpus {
		#address-cells = <0x2>;
		#size-cells = <0x0>;
		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};
				core1 {
					cpu = <&cpu1>;
				};
			};
		};
		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0 0x0>;
			enable-method = "psci";
			cpu-idle-states = <&core_pd>;
			#cooling-cells = <0x2>;
		};
		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0 0x100>;
			enable-method = "psci";
			cpu-idle-states = <&core_pd>;
			#cooling-cells = <0x2>;
		};
	};
	idle-states {
		entry-method = "psci";
		core_pd: cpu-sleep {
			compatible = "arm,idle-state";
			entry-latency-us = <0xfa0>;
			exit-latency-us = <0xfa0>;
			min-residency-us = <0x2710>;
			local-timer-stop;
			arm,psci-suspend-param = <0x10000>;
		};
	};
	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};
	gic: interrupt-controller@12000000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x3>;
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;
		redistributor-stride = <0x0 0x20000>;
		#redistributor-regions = <0x1>;
		interrupt-controller;
		reg = <0x0 0x12000000 0x0 0x20000 0x0 0x12040000 0x0 0x100000>;
		interrupts = <0x1 0x9 0x4>;
		msi-controller@0 {
			compatible = "arm,gic-v2m-frame";
			msi-controller;
			reg = <0x0 0x0 0x0 0x1000>;
			status = "disabled";
		};
	};
	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x1 0xd 0x4 0x1 0xe 0x4 0x1 0xb 0x4 0x1 0xa 0x4>;
		arm,no-tick-in-suspend;
	};
	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x0 0xb2 0x4 0x0 0xb3 0x4>;
	};
	modem: remoteproc@2000 {
		/* CP, V3 PHY and NR boot IRAM: device specification p.547. */
		reg = <0 0x2000 0 0x1000>, <0 0x4000 0 0x1000>,
		      <0 0x5000 0 0x1000>;
		reg-names = "cp-iram", "v3-iram", "nr-iram";
		status = "disabled";
		compatible = "sprd,udx710-modem";
		sprd,aon-apb = <&aon_apb>;
		sprd,pmu-apb = <&pmu_apb>;
	};
	sipc-sipc-pmsys {
		status = "disabled";
		compatible = "sprd,sipc";
		sprd,name = "sipc-pmsys";
		sprd,type = "mbox";
		sprd,dst = <0x6>;
		sprd,core = <0x1>;
		sprd,smem-info = <0x8400 0x60008400 0x2000>;
		mboxes = <&mailbox 0x1>;
		mbox-names = "smsg";
		sprd,smem-type = <0x0>;
	};
	sipc_lte: sipc-sipc-lte {
		status = "disabled";
		compatible = "sprd,sipc";
		sprd,name = "sipc-lte";
		sprd,type = "mbox";
		sprd,dst = <0x5>;
		sprd,core = <0x2>;
		mboxes = <&mailbox 0x2>;
		mbox-names = "smsg";
		sprd,smem-type = <0x0>;
	};
	sipc-sipc-nr-phy {
		status = "disabled";
		compatible = "sprd,sipc";
		sprd,name = "sipc-nr-phy";
		sprd,type = "mbox";
		sprd,dst = <0x7>;
		sprd,core = <0x6>;
		mboxes = <&mailbox 0x6>;
		mbox-names = "smsg";
		sprd,smem-type = <0x0>;
	};
	sipc-sipc-v3-phy {
		status = "disabled";
		compatible = "sprd,sipc";
		sprd,name = "sipc-v3-phy";
		sprd,type = "mbox";
		sprd,dst = <0x8>;
		sprd,core = <0x4>;
		mboxes = <&mailbox 0x4>;
		mbox-names = "smsg";
		sprd,smem-type = <0x0>;
	};
	sipc-sipc-xc4500-0 {
		status = "disabled";
		compatible = "sprd,sipc";
		sprd,name = "sipc-xc4500-0";
		sprd,type = "mbox";
		sprd,dst = <0x1>;
		sprd,core = <0x7>;
		mboxes = <&mailbox 0x7>;
		mbox-names = "smsg";
		sprd,smem-type = <0x0>;
	};
	sipc-sipc-xc4500-1 {
		status = "disabled";
		compatible = "sprd,sipc";
		sprd,name = "sipc-xc4500-1";
		sprd,type = "mbox";
		sprd,dst = <0x2>;
		sprd,core = <0x8>;
		mboxes = <&mailbox 0x8>;
		mbox-names = "smsg";
		sprd,smem-type = <0x0>;
	};
	sipc-sipc-nr {
		compatible = "sprd,sipc";
		sprd,name = "sipc-nr";
		sprd,type = "pcie";
		sprd,dst = <0x0>;
		sprd,client = <0x1>;
		sprd,ep-fun = <0x0>;
		sprd,smem-type = <0x1>;
		sprd,high-offset = <0x0 0x0>;
		interrupts = <0x0 0x4 0x4>;
		status = "disabled";
	};
	usb_reset: usb-reset-controller {
		compatible = "sprd,orca-usb-reset";
		#reset-cells = <0x1>;
		sprd,ap-ahb = <&ap_ahb>;
		sprd,ipa-ahb = <&ipa_ahb>;
	};
	ap_ahb_gate: apahb-gate {
		compatible = "sprd,orca-apahb-gate";
		sprd,syscon = <&ap_ahb>;
		clocks = <&ext_26m>;
		#clock-cells = <0x1>;
	};

	ap_apb_gate: apapb-gate {
		compatible = "sprd,orca-apapb-gate";
		sprd,syscon = <&ap_apb>;
		clocks = <&ext_26m>;
		#clock-cells = <0x1>;
	};

	ipa_gate: ipa-gate {
		compatible = "sprd,orca-ipa-gate";
		sprd,syscon = <&ipa_ahb>;
		clocks = <&ext_26m>;
		#clock-cells = <0x1>;
	};

	g3_pll: g3-pll {
		compatible = "sprd,orca-g3-pll";
		sprd,syscon = <&anlg_g3>;
		clocks = <&ext_26m>;
		#clock-cells = <0x1>;
	};

	pmu-gate {
		compatible = "sprd,orca-pmu-gate";
		sprd,syscon = <&pmu_apb>;
		clocks = <&ext_26m>;
		#clock-cells = <0x1>;
	};

	aon_apb_gate: aonapb-gate {
		compatible = "sprd,orca-aon-gate";
		sprd,syscon = <&aon_apb>;
		clocks = <&ext_26m>;
		#clock-cells = <0x1>;
	};

};

/* UDX710 ADI controller hardware; PMIC selection is board-specific. */
&{/soc/aon-bus} {
	udx710_adi: spi@63a00000 {
		compatible = "sprd,orca-adi";
		reg = <0x0 0x63a00000 0x0 0x200000>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		status = "disabled";
	};
};

/* UDX710 on-die thermal blocks and silicon calibration connections. */
&{/soc/aon-bus} {
	thm0: thermal@63410000 {
		compatible = "sprd,orca-thermal";
		reg = <0x0 0x63410000 0x0 0x10000>;
		clock-names = "enable", "functional";
		clocks = <&aon_apb_gate 0x34 &aon_clk 0x10>;
		#thermal-sensor-cells = <0x1>;
		nvmem-cells = <&thm0_sign_98 &thm0_ratio_98>;
		nvmem-cell-names = "thm_sign_cal", "thm_ratio_cal";
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		status = "disabled";
		apcpu0-sensor@0 {
			reg = <0x0>;
			nvmem-cells = <&thm0_sen0_99>;
			nvmem-cell-names = "sen_delta_cal";
		};
	};

	thm1: thermal@63420000 {
		compatible = "sprd,orca-thermal";
		reg = <0x0 0x63420000 0x0 0x10000>;
		clock-names = "enable", "functional";
		clocks = <&aon_apb_gate 0x35 &aon_clk 0x11>;
		#thermal-sensor-cells = <0x1>;
		nvmem-cells = <&thm1_sign_9a &thm1_ratio_9a>;
		nvmem-cell-names = "thm_sign_cal", "thm_ratio_cal";
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		status = "disabled";
		nrcp-sensor@0 {
			reg = <0x0>;
			nvmem-cells = <&thm1_sen0_9b>;
			nvmem-cell-names = "sen_delta_cal";
		};
	};

	thm2: thermal@63430000 {
		compatible = "sprd,orca-thermal";
		reg = <0x0 0x63430000 0x0 0x10000>;
		clock-names = "enable", "functional";
		clocks = <&aon_apb_gate 0x47 &aon_clk 0x12>;
		#thermal-sensor-cells = <0x1>;
		nvmem-cells = <&thm2_sign_94 &thm2_ratio_94>;
		nvmem-cell-names = "thm_sign_cal", "thm_ratio_cal";
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		status = "disabled";
		apcpu1-sensor@0 {
			reg = <0x0>;
			nvmem-cells = <&thm2_sen0_95>;
			nvmem-cell-names = "sen_delta_cal";
		};
		ank0-sensor@1 {
			reg = <0x1>;
			nvmem-cells = <&thm2_sen1_92>;
			nvmem-cell-names = "sen_delta_cal";
		};
		ank1-sensor@2 {
			reg = <0x2>;
			nvmem-cells = <&thm2_sen2_93>;
			nvmem-cell-names = "sen_delta_cal";
		};
	};
};

/* UDX710 CM4 SRAM window and its AON reset controller. */
/ {
	pmsys: remoteproc@b000 {
		compatible = "sprd,udx710-pmsys";
		reg = <0 0xb000 0 0xdc00>;
		sprd,aon-apb = <&aon_apb>;
		status = "disabled";
	};
};

/ {
	cpufreq {
		compatible = "sprd,orca-cpufreq";
		status = "okay";
	};
};
